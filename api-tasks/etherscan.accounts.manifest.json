{
  "openapi": "3.0.3",
  "info": {
    "title": "Etherscan V2 API - Accounts",
    "description": "API for retrieving account-related data from Etherscan V2, including native and token balances, transactions, and block validation details for EVM-compatible blockchains. Source attribution (e.g., 'Powered by Etherscan.io APIs') is required for non-private use, as per Etherscan's terms (https://docs.etherscan.io).",
    "version": "2.0.0",
    "contact": {
      "name": "Etherscan Support",
      "url": "https://etherscan.io/contactus"
    },
    "license": {
      "name": "Etherscan Terms of Service",
      "url": "https://etherscan.io/terms"
    }
  },
  "servers": [
    {
      "url": "https://api.etherscan.io/v2",
      "description": "Etherscan V2 API base URL"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/api": {
      "get": {
        "operationId": "getAccountData",
        "tags": ["Accounts"],
        "summary": "Retrieve account-related data",
        "description": "Fetches data such as balances, transactions, token transfers, or validated blocks for an address on an EVM-compatible chain, based on the action parameter.",
        "parameters": [
          {
            "$ref": "#/components/parameters/chainid"
          },
          {
            "name": "module",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["account"],
              "default": "account"
            },
            "description": "API module for account-related endpoints."
          },
          {
            "name": "action",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["balance", "balancemulti", "txlist", "txlistinternal", "tokentx", "tokennfttx", "token1155tx", "fundedby", "getminedblocks"]
            },
            "description": "Action to perform: balance (native balance), balancemulti (multiple addresses), txlist (normal transactions), txlistinternal (internal transactions), tokentx (ERC20 transfers), tokennfttx (ERC721 transfers), token1155tx (ERC1155 transfers), fundedby (funding transactions), getminedblocks (validated blocks)."
          },
          {
            "$ref": "#/components/parameters/address"
          },
          {
            "$ref": "#/components/parameters/contractaddress"
          },
          {
            "$ref": "#/components/parameters/txhash"
          },
          {
            "$ref": "#/components/parameters/startblock"
          },
          {
            "$ref": "#/components/parameters/endblock"
          },
          {
            "$ref": "#/components/parameters/blockno"
          },
          {
            "$ref": "#/components/parameters/tag"
          },
          {
            "$ref": "#/components/parameters/page"
          },
          {
            "$ref": "#/components/parameters/offset"
          },
          {
            "$ref": "#/components/parameters/sort"
          },
          {
            "$ref": "#/components/parameters/blocktype"
          },
          {
            "$ref": "#/components/parameters/apikey"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with account data.",
            "headers": {
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                },
                "description": "Maximum number of requests allowed per time period."
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                },
                "description": "Number of requests remaining in the current time period."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/BalanceResponse"
                    },
                    {
                      "$ref": "#/components/schemas/MultiBalanceResponse"
                    },
                    {
                      "$ref": "#/components/schemas/TransactionResponse"
                    },
                    {
                      "$ref": "#/components/schemas/InternalTransactionResponse"
                    },
                    {
                      "$ref": "#/components/schemas/TokenTransferResponse"
                    },
                    {
                      "$ref": "#/components/schemas/NFTTransferResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ERC1155TransferResponse"
                    },
                    {
                      "$ref": "#/components/schemas/FundedByResponse"
                    },
                    {
                      "$ref": "#/components/schemas/MinedBlocksResponse"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters, such as invalid address, chainid, or API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "0",
                  "message": "Invalid address format",
                  "result": null
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded for the API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "0",
                  "message": "Rate limit exceeded",
                  "result": null
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "query",
        "name": "apikey"
      }
    },
    "parameters": {
      "chainid": {
        "name": "chainid",
        "in": "query",
        "required": true,
        "schema": {
          "type": "integer",
          "example": 1,
          "description": "Chain ID of the EVM-compatible blockchain (e.g., 1 for Ethereum Mainnet, 42161 for Arbitrum, 8453 for Base, 137 for Polygon)."
        },
        "description": "Identifies the target blockchain."
      },
      "address": {
        "name": "address",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "example": "0x0B5Ad19cbE540d3607568C3db37a010BBE6c8134",
          "description": "Single address or comma-separated list of up to 20 addresses (for balancemulti)."
        },
        "description": "The address(es) to query."
      },
      "contractaddress": {
        "name": "contractaddress",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$",
          "example": "0x9Adc7710E9d1b29d8a78c04d52d32532297C2Ef3"
        },
        "description": "Token contract address to filter token data (optional for tokentx, tokennfttx, token1155tx)."
      },
      "txhash": {
        "name": "txhash",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{64}$",
          "example": "0x51e42540834734c61fbcca53352ca73102059072b8dd0399a3137e6324678ed4"
        },
        "description": "Transaction hash for internal transactions (required for txlistinternal with txhash)."
      },
      "startblock": {
        "name": "startblock",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 0,
          "example": 7284270
        },
        "description": "Starting block number to search (inclusive)."
      },
      "endblock": {
        "name": "endblock",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 0,
          "example": 99999999
        },
        "description": "Ending block number to search (inclusive)."
      },
      "blockno": {
        "name": "blockno",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 0,
          "example": 7284270
        },
        "description": "Block number to query balance at (optional for balance, balancemulti)."
      },
      "tag": {
        "name": "tag",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": ["earliest", "pending", "latest"]
        },
        "description": "the string pre-defined block parameter, either earliest, pending or latest"
      },
      "page": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "example": 1
        },
        "description": "Page number for paginated results."
      },
      "offset": {
        "name": "offset",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "example": 100
        },
        "description": "Number of records per page (max 1000 for free API plans)."
      },
      "sort": {
        "name": "sort",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": ["asc", "desc"],
          "default": "asc"
        },
        "description": "Sort order of results (ascending or descending)."
      },
      "blocktype": {
        "name": "blocktype",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": ["blocks"],
          "default": "blocks"
        },
        "description": "Type of blocks to query (used for getminedblocks)."
      },
      "apikey": {
        "name": "apikey",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "example": "YourApiKeyToken"
        },
        "description": "Etherscan API key for authentication."
      }
    },
    "schemas": {
      "BalanceResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "1",
            "description": "Status of the response (1 for success, 0 for error)."
          },
          "message": {
            "type": "string",
            "example": "OK",
            "description": "Response message."
          },
          "result": {
            "type": "string",
            "example": "4080717859742745095632",
            "description": "Balance in the smallest unit (e.g., wei for ETH).",
            "nullable": true
          }
        },
        "required": ["status", "message", "result"]
      },
      "MultiBalanceResponse": {
        "type": "object",
