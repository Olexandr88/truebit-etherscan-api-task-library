          },
          "message": {
            "type": "string",
            "example": "OK",
            "description": "Response message."
          },
          "result": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "account": {
                  "type": "string",
                  "example": "0x0B5Ad19cbE540d3607568C3db37a010BBE6c8134",
                  "description": "Address queried."
                },
                "balance": {
                  "type": "string",
                  "example": "4080717859742745095632",
                  "description": "Balance in wei."
                }
              },
              "required": ["account", "balance"]
            },
            "description": "List of address-balance pairs."
          }
        },
        "required": ["status", "message", "result"]
      },
      "TransactionResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
